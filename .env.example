DATABASE_URL=postgresql://petie_user:CHANGE_ME@localhost:5432/petie_db?schema=public
JWT_SECRET=replace-with-random-secret-at-least-32-characters
REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
PUBLIC_URL=http://13.212.26.2
TRUST_PROXY=loopback



# Allow Flutter development on loopback with random ports. Disable after deploying FE.
CORS_ALLOW_LOCALHOST=true


# S3: leave bucket empty for legacy local uploads. AWS credentials are backend-only.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# On EC2 prefer an instance IAM role; SDK reads env credentials automatically.

